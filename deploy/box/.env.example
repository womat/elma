# Vorlage für die ELMA-Box. Normalerweise schreibt ./setup.sh die .env – diese Datei nur für Handarbeit.

# Zusatzdienste: mqtt (Mosquitto + Bridge); leer = keine. Der Cloudflare Tunnel läuft immer.
COMPOSE_PROFILES=
# Image-Version, z. B. v0.3.0; latest = neueste
ELMA_VERSION=latest

# --- Backend (kein Port im LAN: erreichbar nur über den Tunnel, Passkeys brauchen HTTPS) ---
JWT_SECRET=           # z. B. openssl rand -hex 32
PUBLIC_URL=https://elma.deine-domain.at
VAPID_SUBJECT=mailto:deine@email.at

# --- Cloudflare Tunnel, Pflicht (Zero Trust → Networks → Tunnels, Ziel http://backend:3000; siehe docs/cloudflare.md) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Nur mit Profil mqtt: Bridge liest ein Topic vom Mosquitto der Box ---
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=elma
MQTT_PASSWORD=
MQTT_TOPIC=
PAYLOAD_PATH=
PAYLOAD_UNIT=W
PAYLOAD_INVERT=false
DEVICE_TOKEN=
