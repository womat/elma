# --- Bridge (liest den Überschuss vom lokalen Broker) ---
# Im Container ggf. vollen Namen oder IP verwenden (mysmarthome.fritz.box / 192.168.65.42)
MQTT_URL=mqtt://mysmarthome.fritz.box:1883
# Smartfox am Netzanschluss: P > 0 = Netzbezug, P < 0 = Einspeisung (= Überschuss)
MQTT_TOPIC=myhome/smartfox/summary
MQTT_USERNAME=
MQTT_PASSWORD=
# Leer = Payload ist eine reine Zahl. Sonst Pfad im JSON, z. B. "data.surplus"
PAYLOAD_PATH=P
# W oder kW
PAYLOAD_UNIT=W
# true, wenn Einspeisung/Überschuss als negativer Wert kommt
PAYLOAD_INVERT=true
# Geräte-Token aus: docker compose exec backend node src/cli.ts create-producer ...
DEVICE_TOKEN=

# Läuft der Broker auf demselben Gerät wie ELMA: mqtt://host.docker.internal:1883

# --- Backend ---
# Kein ELMA_PORT mehr: Das Backend ist absichtlich nicht im LAN erreichbar, nur über den Tunnel (siehe docker-compose.yml).
JWT_SECRET=bitte-durch-langen-zufallswert-ersetzen
PUBLIC_URL=https://elma.example.com
# Kontakt für Push-Dienste (Google/Apple/Mozilla), Pflicht für Web-Push
VAPID_SUBJECT=mailto:deine@email.at

# --- Cloudflare Tunnel (Token aus dem Cloudflare-Dashboard) ---
CLOUDFLARE_TUNNEL_TOKEN=
